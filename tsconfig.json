// The editor / typecheck project: one program over everything in the repo,
// including the parts that are never emitted (tests, examples, this config).
// Emitting is `tsconfig.build.json`, which drives the two packages through
// project references instead.
{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        // Only the CLI's drawing surface is JSX, but this program covers it too,
        // so the setting has to be here as well as in packages/cli.
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        // packages/view/src/client runs in a browser. The emitting programs stay DOM-free.
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": ["node", "react"],
        // The html-page skill's pages import its kit by this name; its build maps it the same way.
        "paths": {
            "@page/kit": ["./packages/cli/templates/project/agents/skills/html-page/kit/index.ts"]
        }
    },
    "include": [
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "packages/*/test/**/*.ts",
        // The html-page skill's build, kit and templates: shipped as source, run in the sandbox.
        "packages/cli/templates/project/agents/skills/html-page/**/*.ts",
        "packages/cli/templates/project/agents/skills/html-page/**/*.tsx",
        "examples/**/*.ts",
        "vitest.config.ts"
    ]
}

{
    "name": "zenera-monorepo",
    "version": "0.0.0",
    "description": "ZeneraNeo workspace: the library and its command-line front end.",
    "license": "MIT",
    "author": "Andrey Ryabov",
    "homepage": "https://github.com/zenera-ai/ZeneraNeo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zenera-ai/ZeneraNeo.git"
    },
    "bugs": "https://github.com/zenera-ai/ZeneraNeo/issues",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "build": "tsc -b tsconfig.build.json && node packages/view/scripts/bundle.mjs",
        "build:watch": "tsc -b tsconfig.build.json --watch",
        "clean": "tsc -b tsconfig.build.json --clean && rm -rf packages/*/dist coverage .dev .out",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "mermcheck": "node scripts/mermcheck.mjs",
        "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
        "test:watch": "node --env-file=.env ./node_modules/vitest/vitest.mjs",
        "test:coverage": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --coverage",
        "hostile:archives": "node scripts/hostile-archives.mjs",
        "typecheck": "npm run build && tsc -p tsconfig.json --noEmit",
        "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
        "cli": "npm run build --silent && node packages/cli/dist/main.js",
        "cli:link": "npm run build && npm link -w packages/cli",
        "cli:unlink": "npm rm -g @zenera/cli",
        "release": "node scripts/release.mjs",
        "release:check": "npm run format:check && npm run typecheck && npx vitest run --exclude '**/live-*' && npm pack --dry-run $(node scripts/release.mjs workspaces)",
        "release:publish": "npm publish --access public $(node scripts/release.mjs workspaces)",
        "check:node": "node -e \"if (+process.versions.node.split('.')[0] < 24) { console.error('Node >=24 required (running ' + process.version + '). Run: nvm use'); process.exit(1); }\"",
        "demo": "npm run demo --silent -w examples/sdk --"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.18",
        "@vitest/coverage-v8": "^4.1.11",
        "jsdom": "^30.1.1",
        "markdown-dataset": "0.1.0",
        "mermaid": "^12.0.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}

{
    "name": "@zenera/neo",
    "version": "1.2.1",
    "description": "A multi-agent runtime for Node.js: agents, models, tools, skills, memory and an append-only trajectory.",
    "keywords": [
        "agents",
        "ai-agents",
        "multi-agent",
        "llm",
        "agent-runtime",
        "tool-calling",
        "openai",
        "anthropic",
        "gemini",
        "typescript"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "Andrey Ryabov",
    "homepage": "https://github.com/zenera-ai/ZeneraNeo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zenera-ai/ZeneraNeo.git",
        "directory": "packages/neo"
    },
    "bugs": "https://github.com/zenera-ai/ZeneraNeo/issues",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./payload-stores": {
            "types": "./dist/payload-stores/index.d.ts",
            "default": "./dist/payload-stores/index.js"
        },
        "./skill-providers": {
            "types": "./dist/skill-providers/index.d.ts",
            "default": "./dist/skill-providers/index.js"
        },
        "./project": {
            "types": "./dist/project/index.d.ts",
            "default": "./dist/project/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean && rm -rf dist",
        "prepack": "tsc -b"
    },
    "dependencies": {
        "@zenera/sandbox": "^1.2.1",
        "graphology": "^0.26.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@anthropic-ai/sdk": "^0.120.0",
        "@google/genai": "^2.18.0",
        "@openrouter/sdk": "^1.2.80",
        "openai": "^6.0.0"
    },
    "peerDependenciesMeta": {
        "@anthropic-ai/sdk": {
            "optional": true
        },
        "@google/genai": {
            "optional": true
        },
        "@openrouter/sdk": {
            "optional": true
        },
        "openai": {
            "optional": true
        }
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.120.0",
        "@google/genai": "^2.30.0",
        "@openrouter/sdk": "^1.4.25",
        "openai": "^6.0.0"
    }
}

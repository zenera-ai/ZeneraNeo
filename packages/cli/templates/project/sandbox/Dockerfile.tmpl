# The container `run_command` runs in. Built by `zen run` and `zen check`, and
# named by the `sandbox: build:` block in agents.yaml.
#
# It starts from zen's sandbox base: Python and Node, the packages zen's tools
# need, the HTTP clients `requests` (Python) and `axios` (Node), and this `zen`
# itself (the tag is its version - `zen check --fix` moves it after an upgrade).
# Pulled once; built here if it cannot be pulled.
#
# Add what this project always needs below rather than letting an agent install
# it at run time: a root `pip install` or `apt-get` lands in the container's own
# filesystem, which is thrown away.

FROM ghcr.io/zenera-ai/zenera-sandbox:{{version}}

# Examples - uncomment and edit what this project needs. Each change rebuilds the
# image once; later runs reuse it.
#
# Command-line tools for documents and data (Debian packages): PDF to text,
# document conversion, JSON, SQLite, images, audio and video.
# RUN apt-get update \
#     && apt-get install -y --no-install-recommends \
#        poppler-utils pandoc jq sqlite3 imagemagick ffmpeg \
#     && rm -rf /var/lib/apt/lists/*
#
# Python libraries for analysis, charts, spreadsheets and PDFs:
# RUN pip install --no-cache-dir \
#     pandas \
#     numpy \
#     matplotlib \
#     scikit-learn \
#     openpyxl \
#     pypdf
